#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転,,,,,,,,,,,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        ZenkakuHankaku {
            bindings = <&kp LANGUAGE_6>;
            key-positions = <11 12>;
        };

        DeleteKey {
            bindings = <&kp DEL>;
            key-positions = <7 8>;
        };

        InsertKey {
            bindings = <&kp INS>;
            key-positions = <6 7>;
        };

        CenterClick {
            bindings = <&mkp MB3>;
            key-positions = <17 16>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <18 17>;
        };

        PrevClick {
            bindings = <&mkp MB4>;
            key-positions = <27 28>;
        };

        ClickNext {
            bindings = <&mkp MB5>;
            key-positions = <26 27>;
        };

        backtop {
            bindings = <&caps_word>;
            key-positions = <10 1 21 22>;
        };

        english {
            bindings = <&kp LANG8>;
            key-positions = <12 13>;
        };

        japanese {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <16 17>;
        };
    };
    /* ===== 1) マクロ：複数キーを順に送る（BLEの並び替え防止のため40ms推奨） ===== */
    macros {
     // --- iOS用 ---
     em_kill_eol_ios: em_kill_eol_ios {
       compatible = "zmk,behavior-macro";
       #binding-cells = <0>;
       wait-ms = <40>; tap-ms = <40>;
       bindings = <&kp LS(LG(RIGHT))>, <&kp DELETE>; // Shift+Cmd+→ → Delete
     };
     em_del_word_fwd_ios: em_del_word_fwd_ios {
       compatible = "zmk,behavior-macro";
       #binding-cells = <0>;
       wait-ms = <40>; tap-ms = <40>;
       bindings = <&kp LS(LA(RIGHT))>, <&kp DELETE>; // Opt+Shift+→ → Delete
     };

     // --- Android用 ---
     em_kill_eol_andr: em_kill_eol_andr {
       compatible = "zmk,behavior-macro";
       #binding-cells = <0>;
       wait-ms = <40>; tap-ms = <40>;
       bindings = <&kp LS(END)>, <&kp DELETE>;       // Shift+End → Delete
     };
     em_del_word_fwd_andr: em_del_word_fwd_andr {
       compatible = "zmk,behavior-macro";
       #binding-cells = <0>;
       // まずは Ctrl+Delete（非対応アプリがあれば選択→Deleteに切替）
       bindings = <&kp LC(DELETE)>;
     };

     // --- OS/BT同時切替（例：0=Mac,1=iOS,2=Android） ---
     to_mac: to_mac {
       compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <0>; tap-ms = <0>;
       bindings = <&to L_MAC>, <&bt BT_SEL 0>;
     };
     to_ios: to_ios {
       compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <0>; tap-ms = <0>;
       bindings = <&to L_IOS>, <&bt BT_SEL 1>;
     };
     to_andr: to_andr {
       compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <0>; tap-ms = <0>;
       bindings = <&to L_ANDR>, <&bt BT_SEL 2>;
     };
    };
    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
         /* ===== 2) Mod‑Morph：修飾キー検知で置換 ===== */
         /* --- iOS: Ctrl系/Meta系をiOSが理解するCmd/Opt系列に変換 --- */
         c_a_ios: c_a_ios {  // C-a = 行頭
           compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>;
           bindings = <&kp A>, <&kp LG(LEFT)>;     // Cmd+←
           mods = <(MOD_LCTL|MOD_RCTL)>;
         };
         c_e_ios: c_e_ios { bindings = <&kp E>, <&kp LG(RIGHT)>; mods = <(MOD_LCTL|MOD_RCTL)>; };
         m_b_ios: m_b_ios { bindings = <&kp B>, <&kp LA(LEFT)>;  mods = <(MOD_LALT|MOD_RALT)>; };
         m_f_ios: m_f_ios { bindings = <&kp F>, <&kp LA(RIGHT)>; mods = <(MOD_LALT|MOD_RALT)>; };
         c_d_ios: c_d_ios { bindings = <&kp D>, <&kp DELETE>;    mods = <(MOD_LCTL|MOD_RCTL)>; };
         c_k_ios: c_k_ios { bindings = <&kp K>, <&em_kill_eol_ios>; mods = <(MOD_LCTL|MOD_RCTL)>; };
         m_d_ios: m_d_ios { bindings = <&kp D>, <&em_del_word_fwd_ios>; mods = <(MOD_LALT|MOD_RALT)>; };
         c_y_ios: c_y_ios { bindings = <&kp Y>, <&kp LG(V)>;     mods = <(MOD_LCTL|MOD_RCTL)>; }; // Paste
         c_w_ios: c_w_ios { bindings = <&kp W>, <&kp LG(X)>;     mods = <(MOD_LCTL|MOD_RCTL)>; }; // Cut
         m_w_ios: m_w_ios { bindings = <&kp W>, <&kp LG(C)>;     mods = <(MOD_LALT|MOD_RALT)>; }; // Copy
         c_sls_ios: c_sls_ios { bindings = <&kp SLASH>, <&kp LG(Z)>; mods = <(MOD_LCTL|MOD_RCTL)>; }; // Undo
    
         /* --- Android: Home/End と Ctrl 系で意味を再現 --- */
         c_a_andr: c_a_andr { bindings = <&kp A>, <&kp HOME>;    mods = <(MOD_LCTL|MOD_RCTL)>; };
         c_e_andr: c_e_andr { bindings = <&kp E>, <&kp END>;     mods = <(MOD_LCTL|MOD_RCTL)>; };
         m_b_andr: m_b_andr { bindings = <&kp B>, <&kp LC(LEFT)>;  mods = <(MOD_LALT|MOD_RALT)>; };
         m_f_andr: m_f_andr { bindings = <&kp F>, <&kp LC(RIGHT)>; mods = <(MOD_LALT|MOD_RALT)>; };
         c_d_andr: c_d_andr { bindings = <&kp D>, <&kp DELETE>;  mods = <(MOD_LCTL|MOD_RCTL)>; };
         c_k_andr: c_k_andr { bindings = <&kp K>, <&em_kill_eol_andr>; mods = <(MOD_LCTL|MOD_RCTL)>; };
         m_d_andr: m_d_andr { bindings = <&kp D>, <&em_del_word_fwd_andr>; mods = <(MOD_LALT|MOD_RALT)>; };
         c_y_andr: c_y_andr { bindings = <&kp Y>, <&kp LC(V)>;   mods = <(MOD_LCTL|MOD_RCTL)>; };
         c_w_andr: c_w_andr { bindings = <&kp W>, <&kp LC(X)>;   mods = <(MOD_LCTL|MOD_RCTL)>; };
         m_w_andr: m_w_andr { bindings = <&kp W>, <&kp LC(C)>;   mods = <(MOD_LALT|MOD_RALT)>; };
         c_sls_andr: c_sls_andr { bindings = <&kp SLASH>, <&kp LC(Z)>; mods = <(MOD_LCTL|MOD_RCTL)>; };
         /* ===== 2) Mod‑Morph：修飾キー検知で置換 ===== */

    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q               &kp W           &kp E         &kp R  &kp T                                         &kp Y        &kp U  &kp I               &kp O              &kp P
&kp A               &kp S           &kp D         &kp F  &kp G                                         &kp H        &kp J  &kp K               &kp L              &kp SEMI
&kp Z               &kp X           &kp C         &kp V  &kp B                                         &kp N        &kp M  &kp COMMA           &kp DOT            &mt RIGHT_SHIFT SLASH
&mt LEFT_SHIFT TAB  &lt 4 LEFT_ALT  &lt 3 ESCAPE  &none  &kp LEFT_GUI  &mt LCTRL SPACE    &lt 2 SPACE  &lt 5 ENTER         &lt 6 LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SINGLE_QUOTE
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        //1

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &none   &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &none   &none   &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &none     &none   &none   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans  &trans  &trans
            >;
        };

        //2

        MARK {
            bindings = <
&kp EXCLAMATION             &kp DOUBLE_QUOTES  &kp HASH         &kp DOLLAR     &kp PERCENT                      &kp AMPERSAND  &kp SINGLE_QUOTE  &kp MINUS              &kp TILDE             &kp INT_YEN
&kp SLASH                   &kp KP_NUMBER_4    &kp DELETE       &kp SEMICOLON  &kp SEMICOLON                    &kp BACKSPACE  &kp PLUS          &kp ASTERISK           &kp AT_SIGN           &kp EQUAL
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1    &kp KP_NUMBER_2  &kp APOS       &kp SQT                          &kp KP_EQUAL   &kp INT3          &kp LS(RIGHT_BRACKET)  &kp QUESTION          &kp UNDERSCORE
&trans                      &trans             &trans           &trans         &trans         &trans    &trans  &trans                           &kp ASTERISK           &kp LEFT_PARENTHESIS  &kp LS(QUESTION)
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        //3

        CURSOR {
            bindings = <
&trans    &kp LC(LG(LEFT_ARROW))  &kp UP_ARROW  &kp LC(LG(RIGHT_ARROW))  &trans                   &kp KP_MULTIPLY  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp KP_PLUS
&trans    &kp LEFT_ARROW          &kp DOWN      &kp RIGHT_ARROW          &trans                   &kp KP_SLASH     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_MINUS
&kp HOME  &kp PAGE_DOWN           &kp END       &kp PAGE_UP              &trans                   &kp UNDER        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ENTER
&trans    &trans                  &trans        &trans                   &trans  &trans    &none  &kp NUMBER_0                   &kp DOT       &kp ENTER     &kp QUESTION
            >;

            sensor-bindings = <&inc_dec_kp 0 0>;
        };

        //4

        FUNCTION {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5                     &kp LC(LG(NUMBER_1))  &kp LC(LG(NUMBER_2))  &kp LG(LC(NUMBER_3))    &kp NUMBER_0        &kp LC(LA(DELETE))
&kp F6  &kp F7  &kp F8  &kp F9   &kp F10                    &kp LC(LG(NUMBER_4))  &kp LG(LC(N5))        &kp LC(LG(NUMBER_6))    &trans              &kp LC(LS(ESCAPE))
&trans  &trans  &trans  &kp F11  &kp F12                    &kp LC(LG(NUMBER_7))  &kp LG(LEFT_ARROW)    &kp LG(RIGHT_ARROW)     &kp LG(UP_ARROW)    &kp LC(LA(INS))
&trans  &trans  &trans  &trans   &trans   &trans    &trans  &trans                                      &kp LG(LC(LEFT_ARROW))  &kp LG(DOWN_ARROW)  &kp LG(LC(RIGHT_ARROW))
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        //5

        SCROLL {
            bindings = <
&trans    &kp LC(LG(LEFT_ARROW))  &kp UP_ARROW  &kp LC(LG(RIGHT_ARROW))  &trans                    &kp KP_MULTIPLY  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp KP_PLUS
&trans    &kp LEFT_ARROW          &kp DOWN      &kp RIGHT_ARROW          &trans                    &kp KP_SLASH     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_MINUS
&kp HOME  &kp PAGE_DOWN           &kp END       &kp PAGE_UP              &trans                    &kp UNDER        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ENTER
&trans    &trans                  &trans        &trans                   &trans  &trans    &trans  &kp NUMBER_0                   &kp NUMBER_0  &kp DOT       &kp QUESTION
            >;

            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW>;
        };

        //6

        WIRELESS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock                &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };
    };
};
